{
  "name": "cauldroncli",
  "version": "0.1.0",
  "scripts": {
    "local": "npm i file:../CauldronAuthentication file:../CauldronEngine file:../packwiz_js",
    "build": "node build.js",
    "pkg": "pkg dist/cli.cjs --targets node18-win-x64 --output dist/backend-x86_64-pc-windows-msvc",
    "deploy": "npm remove @jackcooperdev/cauldronauthentication @jackcooperdev/cauldronengine @jackcooperdev/packwiz_js && npm i @jackcooperdev/cauldronauthentication @jackcooperdev/cauldronengine @jackcooperdev/packwiz_js"
  },
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackcooperdev/CauldronCLI.git"
  },
  "keywords": [],
  "author": "Jack Cooper",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jackcooperdev/CauldronCLI/issues"
  },
  "bin": {
    "cauldroncli-dev": "./bin/index.js"
  },
  "homepage": "https://github.com/jackcooperdev/CauldronCLI#readme",
  "description": "",
  "dependencies": {
    "@inquirer/prompts": "^7.4.1",
    "@jackcooperdev/cauldronauthentication": "^1.3.4",
    "@jackcooperdev/cauldronengine": "^0.6.6",
    "@jackcooperdev/packwiz_js": "^1.0.8",
    "axios": "^1.16.1",
    "commander": "^13.1.0",
    "cryptr": "^6.3.0",
    "encoding": "^0.1.13",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "node-fetch": "^2.7.0",
    "ora-classic": "^5.4.2",
    "qs": "^6.14.0",
    "rimraf": "^6.0.1",
    "ws": "^8.18.1"
  },
  "pkg": {
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist",
    "scripts": [
      "node_modules/@jackcooperdev/packwiz_js/**/*.js",
      "node_modules/esbuild/**/*.js"
    ],
    "assets": [
      "node_modules/@jackcooperdev/cauldronauthentication/mojang.pem",
      "node_modules/@jackcooperdev/packwiz_js/**/*"
    ]
  },
  "devDependencies": {
    "@types/jsonwebtoken": "~9.0.9",
    "@types/qs": "~6.14.0",
    "@types/ws": "~8.18.1",
    "esbuild": "^0.25.2"
  }
}
