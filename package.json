{
  "name": "cauldroncli",
  "version": "0.3.1",
  "scripts": {
    "local": "npm i file:../CauldronEngine file:../CauldronModManager",
    "build": "node build.js",
    "pkg": "pkg dist/cli.cjs --config package.json --targets node22-win-x64 --output dist/cauldroncli-x86_64-pc-windows-msvc",
    "deploy": "npm remove @jackcooperdev/cauldronengine @jackcooperdev/cmm && npm i @jackcooperdev/cauldronengine @jackcooperdev/cmm"
  },
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackcooperdev/CauldronCLI.git"
  },
  "keywords": [],
  "author": "Jack Cooper",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jackcooperdev/CauldronCLI/issues"
  },
  "bin": {
    "cauldroncli": "./bin/index.js"
  },
  "homepage": "https://github.com/jackcooperdev/CauldronCLI#readme",
  "description": "",
  "dependencies": {
    "@jackcooperdev/cauldronengine": "file:../CauldronEngine",
    "@jackcooperdev/cmm": "file:../CauldronModManager",
    "axios": "^1.18.1",
    "commander": "^15.0.0",
    "jwt-decode": "^4.0.0",
    "ora-classic": "^5.4.2",
    "rimraf": "^6.1.3"
  },
  "allowScripts": {
    "esbuild": true,
    "@yao-pkg/pkg": true
  },
  "pkg": {
    "targets": [
      "node20-win-x64"
    ],
    "outputPath": "dist",
    "scripts": [
      "node_modules/@jackcooperdev/packwiz_js/**/*.js",
      "node_modules/esbuild/**/*.js"
    ],
    "assets": [
      "node_modules/@jackcooperdev/packwiz_js/**/*"
    ]
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.21.0",
    "esbuild": "^0.28.1"
  }
}
